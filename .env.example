# FormalJudge / AgentSafetyBench environment variables
# Copy to .env and fill with your real key(s). Do NOT commit .env.

# Primary API key used by this codebase (xhub-compatible endpoint)
XHUB_API_KEY=your_xhub_api_key_here

# Optional OpenAI-style fallback used in some modules
OPENAI_API_KEY=your_openai_api_key_here

# Used by AgentSafetyBench/evaluation model APIs (OpenRouter endpoint)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional generic fallback used in iterative_refinement
API_KEY=your_generic_api_key_here

# Optional custom OpenAI-compatible base URL
# Defaults to https://api3.xhub.chat/v1 in multiple modules
API_BASE_URL=https://api3.xhub.chat/v1

# Optional Ray temp directory override
RAY_TMPDIR=~/cache
